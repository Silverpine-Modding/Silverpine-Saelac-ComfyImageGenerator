    <Reference Include="Newtonsoft.Json"><HintPath>$(SilverpineGameDir)\BepInEx\plugins\ModdingTools\Newtonsoft.Json.dll</HintPath></Reference>
    <Reference Include="Mono.Cecil"><HintPath>$(SilverpineGameDir)\BepInEx\core\Mono.Cecil.dll</HintPath></Reference>
  </ItemGroup>
