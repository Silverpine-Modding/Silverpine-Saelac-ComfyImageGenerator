+def _adapter_block_map(adapter_blocks, model_blocks):
+    """Map checkpoint block indices to the matching diffusion-model layers."""
+    if adapter_blocks == 28 and model_blocks == 40:
+        original_layers = (i for i in range(40) if i not in _ANIMA_29B_INSERTED_BLOCKS)
+        return dict(enumerate(original_layers))
+    # Preserve upstream behavior for native-depth adapters and other layouts.
+    return {i: i for i in range(min(adapter_blocks, model_blocks))}
 
 
