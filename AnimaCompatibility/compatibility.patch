+def _match_separate_null_tokens(null_tokens, tokens, reference_count):
+    """Repeat per-reference nulls, preserving the full positive-token sequence."""
+    if null_tokens.ndim != 3 or null_tokens.shape[-1] != tokens.shape[-1]:
+        raise ValueError("Unsupported null-token shape for separate references.")
+    if null_tokens.shape[0] == reference_count:
+        result = null_tokens.reshape(1, -1, null_tokens.shape[-1])
+    elif null_tokens.shape[0] == 1:
+        result = null_tokens.repeat(1, reference_count, 1)
+    else:
+        raise ValueError("Null tokens must describe one reference or the complete reference batch.")
+    if result.shape != tokens.shape:
+        raise ValueError("Null-token sequence does not match separately encoded portraits.")
+    return result
+
